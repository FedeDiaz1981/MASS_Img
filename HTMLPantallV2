VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial;
}

/* BACKGROUND GENERAL */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:70px 1fr;
    background:linear-gradient(180deg,#1F3D7A,#2F5EB8 35%,#E6E6E6);
    overflow:hidden;
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    padding:10px 16px;
    gap:6px;
}

.breadcrumb{
    color:#FFFFFF;
    font-size:13px;
    font-weight:600;
    opacity:.9;
}

/* SLICERS AREA */
.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:38px;
    border-radius:10px;
    background:rgba(255,255,255,.15);
    display:flex;
    align-items:center;
    padding-left:10px;
    color:white;
    font-weight:600;
    font-size:12px;
    backdrop-filter:blur(6px);
}

/* MAIN */
.main{
    display:grid;
    grid-template-columns:1fr 300px;
    gap:14px;
    padding:14px;
    min-height:0;
}

/* CANVAS */
.canvas{
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:linear-gradient(180deg,#f4f7fb,#e9eef6);
    box-shadow:0 10px 30px rgba(0,0,0,.12);
}

/* OVERLAY RESULTADOS */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:18px;
    background:rgba(230,235,245,.92);
    backdrop-filter:blur(6px);
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#1F3D7A;
}

.overlay-hint{
    font-size:12px;
    color:#3A3A3A;
}

/* SIDEBAR */
.sidebar{
    display:flex;
    flex-direction:column;
    gap:12px;
    padding:14px;
    border-radius:18px;
    background:#FFFFFF;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
}

/* TITULO SIDEBAR */
.sidebar b{
    color:#1F3D7A;
}

/* CONTADOR */
.counter{
    font-size:28px;
    font-weight:800;
    color:#2F5EB8;
}

/* LISTA */
.related{
    flex:1;
    overflow:auto;
}

/* SCROLL */
.related::-webkit-scrollbar{
    width:8px;
}

.related::-webkit-scrollbar-thumb{
    background:#4C7BE8;
    border-radius:10px;
}
</style>
"
