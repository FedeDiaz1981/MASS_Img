Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá doble click para volver</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial, sans-serif;
    background:transparent;
}

/* CONTENEDOR GENERAL */
.screen{
    position:relative;
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:70px minmax(0,1fr);
    overflow:hidden;
    background:
        radial-gradient(circle at 18% 18%, rgba(76,123,232,0.22), transparent 32%),
        radial-gradient(circle at 82% 78%, rgba(90,62,166,0.18), transparent 36%),
        radial-gradient(circle at 50% 100%, rgba(143,59,110,0.10), transparent 40%),
        linear-gradient(180deg,#1F3D7A 0%, #2F5EB8 36%, #4C7BE8 62%, #E6E6E6 100%);
}

.screen::after{
    content:'';
    position:absolute;
    inset:0;
    background:
        linear-gradient(120deg, rgba(255,255,255,0.025) 25%, transparent 25%),
        linear-gradient(240deg, rgba(255,255,255,0.02) 25%, transparent 25%);
    pointer-events:none;
    z-index:0;
}

/* HEADER */
.header{
    position:relative;
    z-index:1;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:8px 16px;
    gap:6px;
    background:linear-gradient(180deg, rgba(31,61,122,0.94), rgba(47,94,184,0.88));
    border-bottom:1px solid rgba(255,255,255,.10);
}

.breadcrumb{
    color:#FFFFFF;
    font-size:13px;
    font-weight:600;
}

.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:34px;
    border-radius:10px;
    display:flex;
    align-items:center;
    padding-left:10px;
    color:#FFFFFF;
    font-weight:600;
    font-size:12px;
    background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.08);
}

/* BODY */
.main{
    position:relative;
    z-index:1;
    min-height:0;
    width:100%;
    height:100%;
    padding:10px;
    background:
        radial-gradient(circle at top left, rgba(76,123,232,.10), transparent 28%),
        radial-gradient(circle at bottom right, rgba(90,62,166,.08), transparent 30%),
        linear-gradient(180deg, rgba(230,230,230,.70), rgba(214,223,236,.82));
}

/* CANVAS */
.canvas{
    width:100%;
    height:100%;
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.22);
    box-shadow:0 10px 30px rgba(0,0,0,.08);
    backdrop-filter:blur(2px);
}

.canvas::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top left, rgba(76,123,232,.10), transparent 30%),
        radial-gradient(circle at bottom right, rgba(90,62,166,.06), transparent 30%);
    pointer-events:none;
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(230,235,245,.94);
    backdrop-filter:blur(6px);
}

.overlay-header{
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#1F3D7A;
}

.overlay-hint{
    font-size:12px;
    color:#3A3A3A;
}

.overlay-body{
    flex:1;
    min-height:0;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
            "<div class='filter-slot'>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
