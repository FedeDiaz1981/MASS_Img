VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:1280px;
    height:720px;
    font-family:Segoe UI, Arial;
}

/* CONTENEDOR GENERAL */
.screen{
    position:relative;
    width:1280px;
    height:720px;
    display:grid;
    grid-template-rows:80px 640px;
    overflow:hidden;

    background:
        radial-gradient(circle at 20% 20%, rgba(76,123,232,0.25), transparent 35%),
        radial-gradient(circle at 80% 80%, rgba(90,62,166,0.20), transparent 40%),
        linear-gradient(180deg,#1F3D7A 0%, #2F5EB8 40%, #4C7BE8 70%, #E6E6E6 100%);
}

/* HEADER */
.header{
    width:100%;
    height:80px;
    padding:10px 16px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:6px;
}

/* FILTROS */
.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:36px;
    border-radius:10px;
    display:flex;
    align-items:center;
    padding-left:10px;
    color:white;
    font-weight:600;
    font-size:12px;
    background:rgba(255,255,255,.15);
}

/* BODY */
.main{
    width:100%;
    height:640px;
    padding:10px;
}

/* CANVAS */
.canvas{
    width:100%;
    height:100%;
    border-radius:18px;
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(2px);
    box-shadow:0 10px 30px rgba(0,0,0,.15);
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    padding:16px;
    background:rgba(230,235,245,.95);
}
</style>
"
