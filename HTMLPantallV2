Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá doble click para volver</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial;
}

/* CONTENEDOR GENERAL */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:70px 1fr;
    background:linear-gradient(180deg,#1F3D7A,#2F5EB8 35%,#E6E6E6);
    overflow:hidden;
}
.screen::after{
    content:'';
    position:absolute;
    inset:0;
    background:
        linear-gradient(120deg, rgba(255,255,255,0.04) 25%, transparent 25%) ,
        linear-gradient(240deg, rgba(255,255,255,0.03) 25%, transparent 25%);
    pointer-events:none;
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:8px 16px;
    gap:6px;
}

.breadcrumb{
    color:white;
    font-size:13px;
    font-weight:600;
}

/* FILTROS */
.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:34px;
    border-radius:10px;
    display:flex;
    align-items:center;
    padding-left:10px;
    color:white;
    font-weight:600;
    font-size:12px;
    background:rgba(255,255,255,.15);
}

/* BODY FULL */
.main{
    width:100%;
    height:100%;
    padding:12px;
}

/* CANVAS FULL WIDTH */
.canvas{
    width:100%;
    height:100%;
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:linear-gradient(180deg,#EEF3F9,#E4EBF4,#DCE4EE);
    box-shadow:0 10px 30px rgba(0,0,0,.12);
}

/* EFECTO SUAVE */
.canvas::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top left, rgba(76,123,232,.15), transparent 30%),
        radial-gradient(circle at bottom right, rgba(90,62,166,.10), transparent 30%);
    pointer-events:none;
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(230,235,245,.92);
    backdrop-filter:blur(6px);
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#1F3D7A;
}

.overlay-hint{
    font-size:12px;
    color:#3A3A3A;
}

.overlay-body{
    flex:1;
    min-height:0;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
            "<div class='filter-slot'>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
