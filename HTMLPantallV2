Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR DocsRelacionadosHtml =
    [HTML Documentacion Relacionada]

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá doble click para volver al mapa</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial, sans-serif;
}

/* ESTRUCTURA GENERAL */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:74px 1fr;
    overflow:hidden;
    background:linear-gradient(180deg,#1F3D7A 0%, #2F5EB8 100%);
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:8px 14px 6px 14px;
    gap:6px;
    background:linear-gradient(180deg,#1F3D7A 0%, #2F5EB8 100%);
    border-bottom:1px solid rgba(255,255,255,.10);
}

.breadcrumb{
    color:#FFFFFF;
    font-size:13px;
    font-weight:600;
    opacity:.92;
    line-height:1.2;
}

.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:34px;
    border-radius:10px;
    display:flex;
    align-items:center;
    padding:0 10px;
    color:#FFFFFF;
    font-weight:700;
    font-size:12px;
    letter-spacing:.2px;
    background:linear-gradient(180deg,rgba(255,255,255,.16),rgba(255,255,255,.08));
    border:1px solid rgba(255,255,255,.10);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
}

/* BODY */
.main{
    min-height:0;
    display:grid;
    grid-template-columns:minmax(0,1fr) 245px;
    gap:14px;
    padding:10px 14px 14px 14px;
    background:
        linear-gradient(180deg,#DDE4EE 0%, #E6E6E6 100%);
}

/* CANVAS PRINCIPAL */
.canvas{
    position:relative;
    min-height:0;
    border-radius:18px;
    overflow:hidden;
    background:
        linear-gradient(180deg,#EEF3F9 0%, #E4EBF4 55%, #DCE4EE 100%);
    border:1px solid rgba(31,61,122,.10);
    box-shadow:
        0 10px 28px rgba(31,61,122,.12),
        inset 0 1px 0 rgba(255,255,255,.45);
}

/* CAPA DECORATIVA SUAVE */
.canvas::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top left, rgba(76,123,232,.16), transparent 32%),
        radial-gradient(circle at bottom right, rgba(90,62,166,.10), transparent 28%);
    pointer-events:none;
}

/* OVERLAY RESULTADOS */
.overlay{
    position:absolute;
    inset:0;
    z-index:3;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(230,235,245,.93);
    backdrop-filter:blur(6px);
}

.overlay-header{
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:800;
    color:#1F3D7A;
    line-height:1.2;
}

.overlay-hint{
    margin-top:3px;
    font-size:12px;
    color:#3A3A3A;
    opacity:.82;
}

.overlay-body{
    flex:1 1 auto;
    min-height:0;
}

/* PANEL DERECHO */
.sidebar{
    min-height:0;
    display:flex;
    flex-direction:column;
    gap:10px;
    padding:12px;
    border-radius:18px;
    background:
        linear-gradient(180deg,#F8FAFD 0%, #EEF3F9 100%);
    border:1px solid rgba(31,61,122,.10);
    box-shadow:
        0 8px 20px rgba(31,61,122,.10),
        inset 0 1px 0 rgba(255,255,255,.55);
}

.sidebar-title{
    color:#1F3D7A;
    font-size:14px;
    font-weight:800;
    line-height:1.25;
}

.related-frame{
    flex:1 1 auto;
    min-height:0;
    overflow:hidden;
    border-radius:14px;
    background:#FFFFFF;
    border:1px solid rgba(31,61,122,.08);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.55);
    padding:10px;
}

.related{
    width:100%;
    height:100%;
    overflow:auto;
    padding-right:2px;
}

.related::-webkit-scrollbar{
    width:8px;
}

.related::-webkit-scrollbar-thumb{
    background:#4C7BE8;
    border-radius:10px;
}

.related::-webkit-scrollbar-track{
    background:rgba(31,61,122,.06);
    border-radius:10px;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
            "<div class='filter-slot'>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
        "<div class='sidebar'>" &
            "<div class='sidebar-title'>Documentación relacionada</div>" &
            "<div class='related-frame'>" &
                "<div class='related'>" & DocsRelacionadosHtml & "</div>" &
            "</div>" &
        "</div>" &
    "</div>"

RETURN
    HtmlStyles &
    "<div class='screen'>" &
        HtmlHeader &
        HtmlMain &
    "</div>"
