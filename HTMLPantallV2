Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TotalRelacionados =
    [Total Documentos Relacionados]

VAR DocsRelacionadosHtml =
    [HTML Documentacion Relacionada]

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

/* OVERLAY RESULTADOS */
VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá doble click para volver al mapa</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

/* ===== ESTILOS ===== */
VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial;
}

/* BACKGROUND GENERAL */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:70px 1fr;
    background:linear-gradient(180deg,#1F3D7A,#2F5EB8 35%,#E6E6E6);
    overflow:hidden;
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    padding:10px 16px;
    gap:6px;
}

.breadcrumb{
    color:#FFFFFF;
    font-size:13px;
    font-weight:600;
    opacity:.9;
}

/* SLICERS SLOT */
.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:38px;
    border-radius:10px;
    background:rgba(255,255,255,.15);
    display:flex;
    align-items:center;
    padding-left:10px;
    color:white;
    font-weight:600;
    font-size:12px;
}

/* MAIN */
.main{
    display:grid;
    grid-template-columns:1fr 300px;
    gap:14px;
    padding:14px;
    min-height:0;
}

/* CANVAS */
.canvas{
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:linear-gradient(180deg,#f4f7fb,#e9eef6);
    box-shadow:0 10px 30px rgba(0,0,0,.12);
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:18px;
    background:rgba(230,235,245,.92);
    backdrop-filter:blur(6px);
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#1F3D7A;
}

.overlay-hint{
    font-size:12px;
    color:#3A3A3A;
}

.overlay-body{
    flex:1;
    min-height:0;
}

/* SIDEBAR */
.sidebar{
    display:flex;
    flex-direction:column;
    gap:12px;
    padding:14px;
    border-radius:18px;
    background:#FFFFFF;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
}

.sidebar b{
    color:#1F3D7A;
}

/* CONTADOR */
.counter{
    font-size:28px;
    font-weight:800;
    color:#2F5EB8;
}

/* LISTA */
.related{
    flex:1;
    overflow:auto;
}

.related::-webkit-scrollbar{
    width:8px;
}

.related::-webkit-scrollbar-thumb{
    background:#4C7BE8;
    border-radius:10px;
}
</style>
"

/* HEADER */
VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
            "<div class='filter-slot'>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

/* MAIN */
VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
        "<div class='sidebar'>" &
            "<div><b>Documentación relacionada</b></div>" &
            "<div class='counter'>" & TotalRelacionados & "</div>" &
            "<div class='related'>" & DocsRelacionadosHtml & "</div>" &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
