Tabla Documentos HTML =
VAR DocsUnicos =
    SUMMARIZE (
        FILTER (
            Documentos_Url,
            NOT ISBLANK ( Documentos_Url[Name] )
        ),
        Documentos_Url[ID],
        Documentos_Url[Name],
        Documentos_Url[Date modified],
        Documentos_Url[Path]
    )

VAR TotalDocs =
    COUNTROWS ( DocsUnicos )

VAR DocsTop =
    TOPN (
        10,
        DocsUnicos,
        [Date modified], DESC,
        [Name], ASC
    )

VAR LinkupSel =
    CONCATENATEX (
        VALUES ( Linkup[Title] ),
        Linkup[Title],
        ", "
    )

VAR TareaSel =
    CONCATENATEX (
        VALUES ( Tarea[Title] ),
        Tarea[Title],
        ", "
    )

VAR PerdidaSel =
    CONCATENATEX (
        VALUES ( Perdida[Title] ),
        Perdida[Title],
        ", "
    )

VAR NombreCategoria =
    COALESCE (
        LinkupSel,
        TareaSel,
        PerdidaSel,
        "Documentos"
    )

VAR FilasHtml =
    CONCATENATEX (
        DocsTop,
        "<div class='doc-row'>" &
            "<div class='doc-check'>□</div>" &
            "<div class='doc-name'>" &
                "<span class='doc-icon'>📄</span>" &
                "<span class='doc-text'>" & [Name] & "</span>" &
            "</div>" &
            "<div class='doc-date'>" &
                FORMAT ( [Date modified], "dd/MM/yyyy HH:mm" ) &
            "</div>" &
            "<div class='doc-action'>" &
                "<a class='doc-btn' href='" & [Path] & "' target='_blank'>⬇ Descargar PDF&nbsp;&nbsp;›</a>" &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
    "<style>" &
        "*{box-sizing:border-box;}" &
        ".docs-wrap{width:100%;font-family:Segoe UI, Arial, sans-serif;border-radius:12px;overflow:hidden;color:#4f5870;box-shadow:0 8px 22px rgba(0,0,0,.08);background:linear-gradient(180deg, rgba(255,255,255,.45), rgba(236,233,246,.55));}" &
        ".docs-wrap.empty-state{height:100%;padding:24px;color:#556077;background:linear-gradient(180deg, rgba(255,255,255,.55), rgba(235,232,246,.55));}" &
        ".empty{width:100%;min-height:320px;display:flex;align-items:center;justify-content:center;font-size:16px;}" &
        ".docs-header{display:grid;grid-template-columns:36px 1fr 180px 210px;align-items:center;min-height:44px;padding:0 14px;font-size:13px;color:#6b748a;background:rgba(255,255,255,.28);border-bottom:1px solid rgba(120,120,140,.12);font-weight:600;}" &
        ".doc-row{display:grid;grid-template-columns:36px 1fr 180px 210px;align-items:center;min-height:54px;padding:0 14px;border-bottom:1px solid rgba(120,120,140,.10);background:rgba(255,255,255,.14);}" &
        ".doc-row:nth-child(even){background:rgba(255,255,255,.24);}" &
        ".doc-check{color:#9aa3b6;font-size:18px;}" &
        ".doc-name{display:flex;align-items:center;gap:10px;min-width:0;color:#3f4961;font-size:14px;font-weight:500;}" &
        ".doc-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}" &
        ".doc-icon{font-size:18px;flex:0 0 auto;}" &
        ".doc-date{color:#6d7690;font-size:14px;}" &
        ".doc-action{display:flex;justify-content:flex-end;}" &
        ".doc-btn{display:inline-flex;align-items:center;justify-content:center;min-width:168px;height:36px;padding:0 14px;border-radius:6px;text-decoration:none;color:white;font-weight:600;font-size:13px;background:linear-gradient(180deg,#5da2ea,#3d7fca);box-shadow:0 3px 8px rgba(61,127,202,.28);}" &
        ".doc-footer{display:flex;justify-content:flex-end;align-items:center;gap:12px;min-height:44px;padding:0 14px;font-size:13px;color:#68728b;background:rgba(255,255,255,.20);}" &
        ".pager{display:flex;gap:4px;align-items:center;}" &
        ".page{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:4px;background:#eef1f8;color:#5c6781;font-weight:600;}" &
        ".page.active{background:#4b86d5;color:#fff;}" &
    "</style>"

VAR HtmlEmpty =
    "<div class='docs-wrap empty-state'>" &
        HtmlStyles &
        "<div class='empty'>No hay documentos para los filtros seleccionados</div>" &
    "</div>"

VAR HtmlFull =
    "<div class='docs-wrap'>" &
        HtmlStyles &
        "<div class='docs-header'>" &
            "<div>□</div>" &
            "<div>" & NombreCategoria & " · " & TotalDocs & "</div>" &
            "<div>Última modificación</div>" &
            "<div></div>" &
        "</div>" &
        FilasHtml &
        "<div class='doc-footer'>" &
            "<div>Mostrando " & MIN ( 10, TotalDocs ) & " de " & TotalDocs & " documentos</div>" &
            "<div class='pager'>" &
                "<div class='page active'>1</div>" &
                "<div class='page'>2</div>" &
                "<div class='page'>3</div>" &
                "<div class='page'>›</div>" &
            "</div>" &
        "</div>" &
    "</div>"

RETURN
    IF ( TotalDocs = 0, HtmlEmpty, HtmlFull )
