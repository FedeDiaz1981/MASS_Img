Loader HTML = 
"
<style>
*{box-sizing:border-box;margin:0;padding:0;}

html,body{
    width:1280px;
    height:720px;
    margin:0;
    padding:0;
    overflow:hidden;
    font-family:Segoe UI, Arial, sans-serif;
}

.loader-screen{
    position:relative;
    width:1280px;
    height:720px;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(circle at 18% 16%, rgba(76,123,232,0.16), transparent 30%),
        radial-gradient(circle at 82% 22%, rgba(63,79,178,0.14), transparent 28%),
        radial-gradient(circle at 50% 100%, rgba(90,62,166,0.12), transparent 36%),
        linear-gradient(180deg,#1F3D7A 0%, #244789 24%, #2B529A 48%, #D9E1ED 100%);
    animation:loaderHide 10s forwards;
}

.loader-screen::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 22%, transparent 78%, rgba(255,255,255,0.03) 100%);
    pointer-events:none;
}

.loader-card{
    position:relative;
    z-index:2;
    width:360px;
    padding:28px 26px 24px 26px;
    border-radius:22px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:14px;
    background:linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.10) 100%);
    border:1px solid rgba(255,255,255,0.18);
    box-shadow:
        0 22px 48px rgba(18,36,73,0.24),
        inset 0 1px 0 rgba(255,255,255,0.18);
    backdrop-filter:blur(8px);
}

.loader-badge{
    width:62px;
    height:62px;
    border-radius:18px;
    background:linear-gradient(180deg,#4C7BE8 0%, #2F5EB8 100%);
    box-shadow:
        0 14px 30px rgba(31,61,122,0.34),
        inset 0 1px 0 rgba(255,255,255,0.18);
    position:relative;
}

.loader-badge::after{
    content:'';
    position:absolute;
    inset:14px;
    border-radius:10px;
    border:2px solid rgba(255,255,255,0.78);
}

.loader-title{
    color:#FFFFFF;
    font-size:22px;
    font-weight:700;
    letter-spacing:.2px;
    text-align:center;
}

.loader-subtitle{
    color:#EAF1FF;
    font-size:12px;
    font-weight:500;
    opacity:.92;
    text-align:center;
    line-height:1.45;
}

.loader-bar{
    width:240px;
    height:8px;
    border-radius:999px;
    overflow:hidden;
    background:rgba(255,255,255,0.18);
    box-shadow:inset 0 1px 2px rgba(0,0,0,0.10);
}

.loader-bar-fill{
    width:42%;
    height:100%;
    border-radius:999px;
    background:linear-gradient(90deg,#FFFFFF 0%, #AFCBFF 45%, #FFFFFF 100%);
    animation:loadingMove 1.15s ease-in-out infinite;
}

.loader-note{
    color:rgba(255,255,255,0.72);
    font-size:11px;
    letter-spacing:.15px;
}

@keyframes loadingMove{
    0%{transform:translateX(-120px);}
    100%{transform:translateX(240px);}
}

@keyframes loaderHide{
    0%{
        opacity:1;
        visibility:visible;
        pointer-events:auto;
    }
    92%{
        opacity:1;
        visibility:visible;
        pointer-events:auto;
    }
    99%{
        opacity:0;
        visibility:visible;
        pointer-events:none;
    }
    100%{
        opacity:0;
        visibility:hidden;
        pointer-events:none;
    }
}
</style>

<div class='loader-screen'>
    <div class='loader-card'>
        <div class='loader-badge'></div>
        <div class='loader-title'>Cargando visualizador</div>
        <div class='loader-subtitle'>Preparando mapa, filtros y documentación técnica</div>
        <div class='loader-bar'>
            <div class='loader-bar-fill'></div>
        </div>
        <div class='loader-note'>Espere unos segundos...</div>
    </div>
</div>
"
