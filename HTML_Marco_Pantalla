Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

/* OVERLAY SOLO SI ESTADO = 2 */
VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá el botón volver para regresar al mapa</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial, sans-serif;
}

/* LAYOUT */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:78px 1fr;
    background:linear-gradient(180deg,#0f4d86 0%, #1f5f99 100%);
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:10px 16px;
    gap:6px;
}

.breadcrumb{
    color:#ffffff;
    font-size:13px;
    font-weight:600;
}

/* TITULOS (para slicers) */
.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
    color:white;
    font-size:12px;
    font-weight:700;
    opacity:.9;
}

/* MAIN */
.main{
    position:relative;
    background:#e9eef6;
    padding:14px;
    height:100%;
}

/* CANVAS */
.canvas{
    position:absolute;
    inset:14px;
    border-radius:18px;
    overflow:hidden;
    background:rgba(255,255,255,.9);
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(240,245,252,.92);
    backdrop-filter:blur(6px);
}

.overlay-header{
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#2f3f57;
}

.overlay-hint{
    font-size:12px;
    color:#6b7a90;
}

.overlay-body{
    flex:1;
    min-height:0;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div>LINKUP</div>" &
            "<div>TAREAS</div>" &
            "<div>PÉRDIDA</div>" &
            "<div>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
