Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TotalRelacionados =
    [Total Documentos Relacionados]

VAR DocsRelacionadosHtml =
    [HTML Documentacion Relacionada]

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

/* OVERLAY SOLO SI ESTADO = 2 */
VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá el botón volver para regresar al mapa</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial;
}

/* LAYOUT */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:90px 1fr;
    background:linear-gradient(180deg,#0f4d86,#1f5f99 30%,#dbe3ef);
    overflow:hidden;
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    padding:12px 16px;
    gap:8px;
}

.breadcrumb{
    color:white;
    font-size:13px;
    font-weight:600;
}

.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:44px;
    border-radius:12px;
    background:rgba(255,255,255,.15);
    display:flex;
    align-items:center;
    padding-left:10px;
    color:white;
    font-weight:600;
    font-size:13px;
}

/* MAIN */
.main{
    display:grid;
    grid-template-columns:1fr 280px;
    gap:12px;
    padding:12px;
    min-height:0;
}

/* CANVAS */
.canvas{
    position:relative;
    border-radius:16px;
    overflow:hidden;
    background:rgba(255,255,255,.15);
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(240,245,252,.85);
    backdrop-filter:blur(6px);
}

.overlay-header{
    display:flex;
    flex-direction:column;
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#2f3f57;
}

.overlay-hint{
    font-size:12px;
    color:#6b7a90;
}

.overlay-body{
    flex:1;
    min-height:0;
}

/* SIDEBAR */
.sidebar{
    display:flex;
    flex-direction:column;
    gap:10px;
    padding:12px;
    border-radius:16px;
    background:white;
}

.counter{
    font-size:26px;
    font-weight:800;
    color:#284a72;
}

.related{
    flex:1;
    overflow:auto;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
            "<div class='filter-slot'>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
        "<div class='sidebar'>" &
            "<div><b>Documentación relacionada</b></div>" &
            "<div class='counter'>" & TotalRelacionados & "</div>" &
            "<div class='related'>" & DocsRelacionadosHtml & "</div>" &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
