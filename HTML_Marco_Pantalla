Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TotalRelacionados =
    [Total Documentos Relacionados]

VAR DocsRelacionadosHtml =
    [HTML Documentacion Relacionada]

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá el botón volver para regresar al mapa</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}
html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    font-family:Segoe UI, Arial, sans-serif;
}

/* LAYOUT */
.screen{
    width:100%;
    height:100%;
    display:grid;
    grid-template-rows:96px 1fr;
    background:linear-gradient(180deg,#0f4d86 0%, #1f5f99 30%, #dbe3ef 100%);
    overflow:hidden;
}

/* HEADER */
.header{
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:10px 14px 8px 14px;
    gap:8px;
}

.breadcrumb{
    color:#ffffff;
    font-size:13px;
    font-weight:600;
    padding:0 4px;
}

.filters-band{
    width:100%;
    min-height:50px;
    border-radius:14px;
    background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.10);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    padding:8px 10px;
}

.filter-slot{
    height:100%;
    min-height:34px;
    border-radius:10px;
    background:rgba(255,255,255,.10);
    display:flex;
    align-items:center;
    padding:0 12px;
    color:#ffffff;
    font-weight:700;
    font-size:12px;
    letter-spacing:.2px;
    white-space:nowrap;
}

/* MAIN */
.main{
    display:grid;
    grid-template-columns:minmax(0,1fr) 290px;
    gap:12px;
    padding:12px;
    min-height:0;
}

/* CANVAS */
.canvas{
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:rgba(255,255,255,.16);
    border:1px solid rgba(255,255,255,.18);
    box-shadow:0 10px 24px rgba(13,41,79,.10);
    min-height:0;
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(240,245,252,.88);
    backdrop-filter:blur(6px);
}

.overlay-header{
    display:flex;
    flex-direction:column;
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#2f3f57;
}

.overlay-hint{
    font-size:12px;
    color:#6b7a90;
}

.overlay-body{
    flex:1;
    min-height:0;
}

/* SIDEBAR */
.sidebar{
    display:flex;
    flex-direction:column;
    gap:12px;
    padding:12px;
    border-radius:18px;
    background:rgba(255,255,255,.92);
    border:1px solid rgba(220,228,238,.95);
    box-shadow:0 10px 24px rgba(13,41,79,.08);
    min-height:0;
}

.sidebar-title{
    font-size:15px;
    font-weight:700;
    color:#31445c;
}

.counter-box{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:10px 12px;
    border-radius:12px;
    background:linear-gradient(180deg,#f4f7fb,#e9eef6);
    border:1px solid #dde5f0;
}

.counter-label{
    font-size:12px;
    font-weight:600;
    color:#6a7a8f;
}

.counter{
    font-size:26px;
    font-weight:800;
    color:#284a72;
    line-height:1;
}

.related-frame{
    flex:1;
    min-height:0;
    border-radius:14px;
    border:1px solid #d9e2ee;
    background:#f8fbff;
    padding:10px;
    display:flex;
    flex-direction:column;
    gap:8px;
    overflow:hidden;
}

.related-title{
    font-size:13px;
    font-weight:700;
    color:#51647d;
}

.related{
    flex:1;
    min-height:0;
    overflow:auto;
    padding-right:2px;
}

.related::-webkit-scrollbar{
    width:7px;
}

.related::-webkit-scrollbar-thumb{
    background:rgba(83,107,141,.25);
    border-radius:8px;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters-band'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
            "<div class='filter-slot'>TECNOLOGÍA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
        "<div class='sidebar'>" &
            "<div class='sidebar-title'>Documentación relacionada</div>" &
            "<div class='counter-box'>" &
                "<div class='counter-label'>Total documentos</div>" &
                "<div class='counter'>" & FORMAT ( TotalRelacionados, "#,0" ) & "</div>" &
            "</div>" &
            "<div class='related-frame'>" &
                "<div class='related-title'>Listado</div>" &
                "<div class='related'>" & DocsRelacionadosHtml & "</div>" &
            "</div>" &
        "</div>" &
    "</div>"

RETURN
    HtmlStyles &
    "<div class='screen'>" &
        HtmlHeader &
        HtmlMain &
    "</div>"
