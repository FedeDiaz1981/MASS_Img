Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá doble click para volver</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}

html,body{
    margin:0;
    padding:0;
    width:1280px;
    height:720px;
    font-family:Segoe UI, Arial, sans-serif;
}

/* CONTENEDOR GENERAL */
.screen{
    position:relative;
    width:1280px;
    height:720px;
    display:grid;
    grid-template-rows:80px 640px;
    overflow:hidden;
    background:
        radial-gradient(circle at 18% 16%, rgba(76,123,232,0.14), transparent 30%),
        radial-gradient(circle at 82% 22%, rgba(63,79,178,0.12), transparent 28%),
        radial-gradient(circle at 50% 100%, rgba(90,62,166,0.10), transparent 36%),
        linear-gradient(180deg,#1F3D7A 0%, #244789 24%, #2B529A 48%, #D9E1ED 100%);
}

/* CAPA SUAVE PARA DAR PROFUNDIDAD */
.screen::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 22%, transparent 78%, rgba(255,255,255,0.03) 100%);
    pointer-events:none;
}

/* HEADER */
.header{
    position:relative;
    z-index:1;
    width:100%;
    height:80px;
    padding:10px 16px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:6px;
    background:linear-gradient(180deg, rgba(31,61,122,0.90) 0%, rgba(47,94,184,0.72) 100%);
    border-bottom:1px solid rgba(255,255,255,0.08);
    box-shadow:0 1px 0 rgba(255,255,255,0.06) inset;
}

.breadcrumb{
    color:#F4F7FC;
    font-size:13px;
    font-weight:600;
    letter-spacing:.1px;
    opacity:.96;
}

/* FILTROS */
.filters{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.filter-slot{
    height:36px;
    border-radius:11px;
    display:flex;
    align-items:center;
    padding-left:12px;
    color:#F6F9FF;
    font-weight:700;
    font-size:12px;
    letter-spacing:.2px;
    background:linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.06) 100%);
    border:1px solid rgba(255,255,255,0.10);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.08),
        0 6px 16px rgba(16,33,68,0.10);
}

/* BODY */
.main{
    position:relative;
    z-index:1;
    width:100%;
    height:640px;
    padding:10px;
}

/* CANVAS */
.canvas{
    width:100%;
    height:100%;
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:
        linear-gradient(180deg, rgba(247,250,253,0.18) 0%, rgba(234,240,247,0.12) 100%);
    border:1px solid rgba(255,255,255,0.18);
    box-shadow:
        0 18px 40px rgba(18,36,73,0.18),
        inset 0 1px 0 rgba(255,255,255,0.20);
    backdrop-filter:blur(2px);
}

/* ILUMINACIÓN SUTIL DEL CANVAS */
.canvas::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top left, rgba(255,255,255,0.10), transparent 26%),
        radial-gradient(circle at bottom right, rgba(76,123,232,0.08), transparent 30%);
    pointer-events:none;
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:
        linear-gradient(180deg, rgba(236,241,248,0.96) 0%, rgba(228,235,245,0.97) 100%);
    backdrop-filter:blur(6px);
}

.overlay-header{
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#1F3D7A;
    letter-spacing:.1px;
}

.overlay-hint{
    margin-top:2px;
    font-size:12px;
    color:#3A3A3A;
    opacity:.80;
}

.overlay-body{
    flex:1;
    min-height:0;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
