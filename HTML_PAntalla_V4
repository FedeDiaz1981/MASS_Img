Pantalla HTML = 

VAR Estado = [Estado Pantalla]

VAR BreadcrumbTxt =
    "Inicio > Departamento > Equipo > Máquina"

VAR TablaResultadosHtml =
    [Tabla Documentos HTML]

VAR OverlayHtml =
    IF (
        Estado = 2,
        "<div class='overlay'>" &
            "<div class='overlay-header'>" &
                "<div class='overlay-title'>Resultados</div>" &
                "<div class='overlay-hint'>Usá doble click para volver</div>" &
            "</div>" &
            "<div class='overlay-body'>" &
                TablaResultadosHtml &
            "</div>" &
        "</div>",
        ""
    )

VAR HtmlStyles =
"
<style>
*{box-sizing:border-box;}

html,body{
    margin:0;
    padding:0;
    width:1280px;
    height:720px;
    font-family:Segoe UI, Arial, sans-serif;
}

/* CONTENEDOR GENERAL */
.screen{
    position:relative;
    width:1280px;
    height:720px;
    display:grid;
    grid-template-rows:80px 640px;
    overflow:hidden;

    background:
        radial-gradient(circle at 20% 20%, rgba(76,123,232,0.25), transparent 35%),
        radial-gradient(circle at 80% 80%, rgba(90,62,166,0.20), transparent 40%),
        linear-gradient(180deg,#1F3D7A 0%, #2F5EB8 40%, #4C7BE8 70%, #E6E6E6 100%);
}

/* HEADER */
.header{
    width:100%;
    height:80px;
    padding:10px 16px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:6px;
}

.breadcrumb{
    color:white;
    font-size:13px;
    font-weight:600;
}

/* FILTROS */
.filters{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.filter-slot{
    height:36px;
    border-radius:10px;
    display:flex;
    align-items:center;
    padding-left:10px;
    color:white;
    font-weight:600;
    font-size:12px;
    background:rgba(255,255,255,.15);
    border:1px solid rgba(255,255,255,.08);
}

/* BODY */
.main{
    width:100%;
    height:640px;
    padding:10px;
}

/* CANVAS */
.canvas{
    width:100%;
    height:100%;
    position:relative;
    border-radius:18px;
    overflow:hidden;
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(2px);
    box-shadow:0 10px 30px rgba(0,0,0,.15);
}

/* OVERLAY */
.overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    padding:16px;
    background:rgba(230,235,245,.95);
}

.overlay-header{
    margin-bottom:10px;
}

.overlay-title{
    font-size:16px;
    font-weight:700;
    color:#1F3D7A;
}

.overlay-hint{
    font-size:12px;
    color:#3A3A3A;
}

.overlay-body{
    flex:1;
    min-height:0;
}
</style>
"

VAR HtmlHeader =
    "<div class='header'>" &
        "<div class='breadcrumb'>" & BreadcrumbTxt & "</div>" &
        "<div class='filters'>" &
            "<div class='filter-slot'>LINKUP</div>" &
            "<div class='filter-slot'>TAREAS</div>" &
            "<div class='filter-slot'>PÉRDIDA</div>" &
        "</div>" &
    "</div>"

VAR HtmlMain =
    "<div class='main'>" &
        "<div class='canvas'>" &
            OverlayHtml &
        "</div>" &
    "</div>"

RETURN
HtmlStyles &
"<div class='screen'>" &
    HtmlHeader &
    HtmlMain &
"</div>"
