{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/view-formatting.schema.json",
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "12px",
      "padding": "10px"
    },
    "children": [
      {
        "elmType": "div",
        "forEach": "row in @rows",
        "style": {
          "border": "1px solid #edebe9",
          "border-radius": "10px",
          "padding": "12px",
          "width": "250px",
          "background-color": "#ffffff",
          "box-shadow": "0 1px 4px rgba(0,0,0,0.08)"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "ID: [$row.ID]",
            "style": {
              "font-weight": "600",
              "margin-bottom": "6px"
            }
          },
          {
            "elmType": "div",
            "txtContent": "Título: [$row.FileLeafRef]",
            "style": {
              "color": "#605e5c"
            }
          }
        ]
      }
    ]
  }
}
